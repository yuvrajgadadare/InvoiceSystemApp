 
@{
    Layout = "~/Views/Shared/InvoiceLayout.cshtml";
}
<div class="container-fluid">
    <h4>New Invoice</h4>
    <div class="row">
        <table class="table table-borderless">
            <tr>
                <td style="text-align:right">Customer Name:</td>
                <td>
                    @Html.DropDownList("ddcustomer", ViewBag.customers as SelectList, "Select Customer", new { @class = "form-control" })
                </td>
                <td style="text-align:right">Invoice Date:</td>
                <td>
                    <input type="date" class="form-control" id="txtdate" />
                </td>
            </tr>
        </table>
        <table class="table table-borderless">
            <tr>
                <td style="width:20%">
                    <label>Product</label>
                    @Html.DropDownList("ddproduct", ViewBag.products as SelectList, "Select Product", new { @class = "form-control", @onchange = "fetchProduct()" })
                </td>
                <td style="width:10%">
                    <label>Rate</label>
                    <input type="text" class="form-control" id="txtrate" disabled />
                </td>
                <td style="width:10%">
                    <label>Gst</label>
                    <input type="text" class="form-control" id="txtgst" disabled />
                </td>
                <td style="width:10%">
                    <label>Stock</label>
                    <input type="text" class="form-control" id="txtstock" disabled />
                </td>
                <td style="width:10%">
                    <label>Quantity</label>
                    <input type="text" class="form-control" id="txtquantity" onkeyup="calculate()" />
                </td>
                <td style="width:10%">
                    <label>Total</label>
                    <input type="text" class="form-control" id="txttotal" disabled />
                </td>
                <td>
                    <br />
                    <input type="button" class="btn btn-primary btn-sm" id="btnadd" value="+" onclick="addProduct()" />
                </td>
            </tr>
        </table>

    </div>
    <hr />
    <div class="row">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Sr No</th>
                    <th>Product Name</th>
                    <th>Rate</th>
                    <th>Gst</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody id="tbldata"></tbody>
            <tfoot>
                <tr>
                    <td colspan="5" style="text-align:right">Total = </td>
                    <td><b id="finaltotal"></b></td>
                </tr>
            </tfoot>
        </table>

    </div>
    <div class="row">
        <input type="button" value="Submit" class="btn btn-primary" onclick="GenerateNewInvoice()"/>
    </div>
</div>

<script>
    var pname="";
    var final=0;
    var products=[];
    const fetchProduct=async()=>{
        var pid=document.getElementById("ddproduct").value;
   
        const response = await fetch("/Product/GetProduct/"+pid)
        const p=await response.json();
        console.log(p);
        pname = p.productName;
        document.getElementById("txtrate").value=p.rate;
        document.getElementById("txtgst").value = p.gst;
        document.getElementById("txtstock").value = p.stockQuantity;
        calculate();
    }
   

    const calculate=()=>{
    
        var rate = Number(document.getElementById("txtrate").value);
        var gst = Number(document.getElementById("txtgst").value);
        var qty = Number(document.getElementById("txtquantity").value);
        var total=(rate+(rate*gst/100))*qty;
        document.getElementById("txttotal").value=total.toFixed(2);
    
    }

    const addProduct=()=>{
    
        var pid=document.getElementById("ddproduct").value;
      //  console.log(pid+" "+pname );
        var rate = Number(document.getElementById("txtrate").value);
        var gst = Number(document.getElementById("txtgst").value);
        var qty = Number(document.getElementById("txtquantity").value);
        var total = Number(document.getElementById("txttotal").value);
        var st = { "ProductId":pid,"ProductName":pname,"Rate":rate,"Gst":gst,"Quantity":qty,"Total":total};
        products.push(st);
        console.log(products);
        displayTable();
    }

    const displayTable=()=>{
        
        final=0;
        var data="";
        products.forEach(function(d,k){
            final=final+Number(d.Total);
            data+="<tr><td>"+(k+1)+"</td><td>"+d.ProductName+"</td><td>"+d.Rate+"</td><td>"+d.Gst+"</td><td>"+d.Quantity+"</td><td>"+d.Total+"</td></tr>";
        })
        document.getElementById("tbldata").innerHTML=data;
        document.getElementById("finaltotal").innerHTML=final;
        
    }

    const GenerateNewInvoice=async()=>{
        var cid=document.getElementById("ddcustomer").value;
        var dt=document.getElementById("txtdate").value;
        var st={"CustomerId":cid,"InvoiceDate":dt,"InvoiceAmount":final,"InvoiceProducts":products};

        const response=await fetch("/Invoice/GenerateInvoice",{
            method:"post",
            "body":JSON.stringify(st),
            "headers":{
                "content-type":"application/json"
            }
        });
        if(response.status==200){
        var obj=await response.json();
        console.log(obj);
        
        alert("Invoice Generated Successfully");
        window.location.reload();
        }
        else{
            alert("Error!!");
        }

    }
</script>